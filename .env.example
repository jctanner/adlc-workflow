# Local-only compose settings. Copy this file to .env and edit it.
ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id
CLAUDE_CODE_USE_VERTEX=1
CLOUD_ML_REGION=global

# Optional local-run overrides.
# ADLC_CLAUDE_MODEL=claude-haiku-4-5
# ADLC_CONTROLLER_MODE=claude  # claude, handoff (wrapper skill), or cli
# ADLC_CONTROLLER_JSON=1       # CLI mode: normalized live JSONL events
# ADLC_EXAMPLE_RFE_COUNT=2      # Set to 1 for a faster disposable example
# ADLC_ITEM_PARALLELISM=1       # Opt in to concurrent batch items (e.g. 2)
# ADLC_HANDOFF_DANGEROUSLY_SKIP_PERMISSIONS=1
# ADLC_ISSUE_KEY=RHAIRFE-1
# JIRA_USER=admin
# JIRA_TOKEN=jira-emulator-default-token
# ADLC_HOST_ADC_PATH=/absolute/path/to/application_default_credentials.json
