#!/usr/bin/env python3
"""Resolve a public artifact path from the active ADLC profile."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

SCRIPT_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(SCRIPT_ROOT / "src"))

from adlc_workflow.artifacts import ArtifactLayout  # noqa: E402
from adlc_workflow.profiles import load_profile  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "kind",
        choices=("task", "strategy", "review", "decomposition", "published", "context-manifest", "selection", "result"),
    )
    parser.add_argument("issue_key", nargs="?")
    parser.add_argument("--profile", default="config/rhai-feature-creator.yaml")
    parser.add_argument("--workspace", default=".")
    parser.add_argument("--install-root", default=str(SCRIPT_ROOT))
    args = parser.parse_args()
    layout = ArtifactLayout(Path(args.workspace).resolve(), load_profile(args.install_root, args.profile))
    if args.kind in {"task", "review", "decomposition"} and not args.issue_key:
        parser.error(f"{args.kind} requires an issue key")
    if args.kind in {"task", "strategy"}:
        print(layout.task(args.issue_key))
    elif args.kind == "review":
        print(layout.review(args.issue_key))
    elif args.kind == "decomposition":
        print(layout.generated("decomposition", args.issue_key))
    elif args.kind == "published":
        print(layout.root("published"))
    elif args.kind == "context-manifest":
        print(layout.root("inputs") / "context-manifest.json")
    elif args.kind == "selection":
        print(layout.evidence_path("selection"))
    else:
        print(layout.evidence_path("result"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
