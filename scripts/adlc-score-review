#!/usr/bin/env python3
"""Score configured review inputs using the active profile rubric."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

SCRIPT_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(SCRIPT_ROOT / "src"))

from adlc_workflow.profiles import load_profile  # noqa: E402
from adlc_workflow.scoring import score_review  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("issue_key")
    parser.add_argument("--workspace", default=".")
    parser.add_argument("--profile", required=True)
    parser.add_argument("--install-root", default=str(SCRIPT_ROOT))
    args = parser.parse_args()
    result = score_review(
        Path(args.install_root).absolute(),
        Path(args.workspace).resolve(),
        load_profile(args.install_root, args.profile),
        args.issue_key,
        args.profile,
    )
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
