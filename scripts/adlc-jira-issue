#!/usr/bin/env python3
"""Fetch one Jira issue using the ADLC container environment."""

from __future__ import annotations

import argparse
import json
import os
import sys
from urllib.error import HTTPError, URLError
from urllib.parse import quote
from urllib.request import Request, urlopen


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("issue_key")
    parser.add_argument("--fields", help="comma-separated Jira fields")
    args = parser.parse_args()
    base_url = os.environ.get("ADLC_JIRA_URL")
    token = os.environ.get("ADLC_JIRA_TOKEN")
    if not base_url:
        print("ADLC_JIRA_URL is required", file=sys.stderr)
        return 2
    if not token:
        print("ADLC_JIRA_TOKEN is required", file=sys.stderr)
        return 2
    url = f"{base_url.rstrip('/')}/rest/api/2/issue/{quote(args.issue_key, safe='')}"
    if args.fields:
        url += "?fields=" + quote(args.fields, safe=",")
    request = Request(url, headers={"Authorization": f"Bearer {token}", "Accept": "application/json"})
    try:
        with urlopen(request, timeout=30) as response:
            value = json.load(response)
    except (HTTPError, URLError, TimeoutError, json.JSONDecodeError) as exc:
        print(f"Jira request failed: {exc}", file=sys.stderr)
        return 1
    json.dump(value, sys.stdout, indent=2, sort_keys=True)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
